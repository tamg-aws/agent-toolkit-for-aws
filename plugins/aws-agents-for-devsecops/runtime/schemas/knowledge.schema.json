{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "knowledge advisory input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inventory",
    "revision",
    "author",
    "citations",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": "knowledge-v1"
    },
    "inventory": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "start_line",
          "end_line",
          "file_sha256",
          "quote_sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "file_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "quote_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "label",
          "citation_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "kind": {
            "enum": [
              "component",
              "asset"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "citation_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "relationship",
          "citation_ids",
          "assessment"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "relationship": {
            "enum": [
              "calls",
              "reads",
              "writes",
              "depends_on",
              "contains",
              "protects",
              "affects"
            ]
          },
          "citation_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
            }
          },
          "assessment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reviewer",
              "verdict",
              "reason"
            ],
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "verdict": {
                "enum": [
                  "supported",
                  "unknown",
                  "disputed"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16000
              }
            }
          }
        }
      }
    }
  }
}
